test BreakdownRestoration {
  functions [BreakdownMicroMotive]
  args {
    input {
      title "Restoring well-made things"
      statement "I like observing people repair high-quality things to their former glory."
      why_it_matters "The reward is seeing lost quality return."
      boundary_conditions "The original thing must have been well made."
      evidence [
        {
          situation "Watching a mechanic repair an engine head."
          reaction "The restoration itself was satisfying."
          feelings ["absorbed", "satisfied"]
        }
      ]
    }
  }
}
